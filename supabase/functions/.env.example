# Set these ONLY as Supabase Edge Function secrets, never EXPO_PUBLIC_ values.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are supplied by hosted Supabase.
APPLE_CLIENT_ID=YOUR_APPLE_SERVICES_ID
APPLE_TEAM_ID=YOUR_TEAM_ID
APPLE_KEY_ID=YOUR_KEY_ID
APPLE_PRIVATE_KEY_BASE64=BASE64_OF_YOUR_P8_SIGNING_KEY
# Generate a random 32-byte key locally. Do not commit the real keyring.
ACCOUNT_TOKEN_ACTIVE_KEY=key1
ACCOUNT_TOKEN_KEYRING={"key1":"BASE64_OF_RANDOM_32_BYTE_KEY"}
